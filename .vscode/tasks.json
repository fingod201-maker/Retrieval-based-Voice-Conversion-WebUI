{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Monitor CC1080p RVC training",
			"type": "process",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": ["-u", "tools\\monitor_training.py"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"showReuseMessage": false
			}
		},
		{
			"label": "Start RVC realtime conversion",
			"type": "process",
			"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
			"args": ["gui_v1.py"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": false,
			"problemMatcher": []
		}
	]
}